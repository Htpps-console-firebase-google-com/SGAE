    "🤖 GeoPintar Engine: analisis geopolitik selesai.",
    "🧠 Neural Core: model dilatih semula.",
    "🚨 Ancaman dihalang daripada gateway tidak dikenali.",
    "📜 Sijil baharu didaftarkan: CERT-51-7734.",
    "🌍 GeoBot: 1,247 pertanyaan dijawab hari ini."
];

function initSGAELog() {
    const logBox = document.getElementById("sgAE-log");
    if (!logBox) return;
    setInterval(() => {
        const msg = sgAELogs[Math.floor(Math.random() * sgAELogs.length)];
        const time = new Date().toLocaleTimeString();
        const line = document.createElement("div");
        line.className = "log-line";
        line.innerHTML = `<span class="log-time">[${time}]</span> <span class="log-msg">${msg}</span>`;
        logBox.appendChild(line);
        logBox.scrollTop = logBox.scrollHeight;
        if (logBox.children.length > 30) logBox.removeChild(logBox.firstChild);
    }, 3500);
}
document.addEventListener("DOMContentLoaded", initSGAELog);
```

